{
  "name": "duet",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": []
}
