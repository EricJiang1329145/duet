{
  "name": "duet-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dev-assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
